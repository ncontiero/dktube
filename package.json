{
  "name": "dktube",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "description": "A project based on Youtube.",
  "author": "Nicolas Contiero <https://github.com/ncontiero>",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm db:generate && pnpm db:migrate:prod && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck",
    "db:generate": "dotenv -e .env -- prisma generate",
    "db:push": "dotenv -e .env -- prisma db push",
    "db:migrate": "dotenv -e .env -- prisma migrate dev",
    "db:migrate:prod": "dotenv -e .env -- prisma migrate deploy",
    "db:studio": "dotenv -e .env -- prisma studio",
    "db:seed": "dotenv -e .env -- prisma db seed",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "pre-commit": "lint-staged",
    "postinstall": "pnpm db:generate && next typegen"
  },
  "dependencies": {
    "@clerk/localizations": "4.15.5",
    "@clerk/nextjs": "7.8.0",
    "@clerk/themes": "2.4.57",
    "@hookform/resolvers": "5.9.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@t3-oss/env-nextjs": "0.13.11",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.33.0",
    "next": "16.3.2",
    "next-safe-action": "8.6.1",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.86.0",
    "react-player": "3.4.0",
    "react-toastify": "11.1.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@ncontiero/eslint-config": "8.4.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "25.9.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "dotenv-cli": "11.0.0",
    "eslint": "10.9.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "postcss": "8.5.26",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "prisma": {
    "seed": "pnpm db:seed"
  },
  "lint-staged": {
    "*": "pnpm lint:fix"
  }
}
